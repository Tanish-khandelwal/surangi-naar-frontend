datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

model Product {
  id              String   @id @default(cuid())
  name            String
  category        String
  categorySlug    String
  price           Int
  originalPrice   Int?
  colorVariants   Json     @default("[]") // [{ name, hex, images: string[] }]
  sizes           String[]
  image           String
  secondaryImage  String?
  badge           String?
  rating          Float    @default(5.0)
  isSoldOut       Boolean  @default(false)
  stockQuantity   Int      @default(10)
  description     String?
  fabric          String?
  care            String?
  craftsmanship   String?
  shipping        String?
  reviews         Review[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Category {
  id        String  @id
  slug      String  @unique
  name      String
  count     String?
  image     String
  tagline   String?
}

model HeroSlide {
  id            Int      @id @default(autoincrement())
  subtitle      String
  title         String
  description   String
  cta           String
  categorySlug  String
  image         String
  order         Int      @default(0)
}

model PromoMessage {
  id      Int    @id @default(autoincrement())
  message String
  order   Int    @default(0)
}

model DiscountCode {
  id              String   @id @default(cuid())
  code            String   @unique
  discountPercent Int
  minSpend        Int      @default(0)
  description     String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model StoreSettings {
  id                    Int     @id @default(1)
  phone                 String
  displayPhone          String
  email                 String
  instagram             String?
  instagramHandle       String?
  facebook              String?
  whatsapp              String?
  address               String
  googleMaps            String?
  hours                 String
  shippingFee           Int     @default(250)
  freeShippingThreshold Int     @default(5000)
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  phone         String?
  passwordHash  String?        // nullable for Google-auth users
  provider      String         @default("email") // "email" | "google"
  avatar        String?
  role          String         @default("customer") // "customer" | "admin"
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  addresses     Address[]
  cartItems     CartItem[]
  wishlist      WishlistItem[]
  orders        Order[]
  reviews       Review[]
  createdAt     DateTime       @default(now())
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  street    String
  city      String
  state     String
  pincode   String
  isDefault Boolean @default(false)
}

model CartItem {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  colorName String
  size      String
  quantity  Int
}

model WishlistItem {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
}

model Order {
  id                String   @id // format: "ORD-XXXX" matching existing pattern
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName      String
  customerEmail     String
  customerPhone     String
  customerAddress   String
  items             Json     // [{ id, name, size, color, quantity, price }]
  total             Int
  status            String   @default("Pending") // Pending, Processing, Delivered, Cancelled
  paymentMethod     String
  razorpayOrderId   String?
  razorpayPaymentId String?
  idempotencyKey    String?  @unique
  trackingNumber    String?
  carrier           String?
  refundRequired    Boolean  @default(false)
  cancellationReason String?
  statusHistory     Json?    // [{ status, timestamp }]
  createdAt         DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
}
